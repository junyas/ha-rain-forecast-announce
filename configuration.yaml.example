# configuration.yaml に追記する。appid は secrets.yaml に `yolp_appid: <取得した ID>` で置く
# 座標は HA の「ホーム」ゾーンから読む（経度,緯度 の順は YOLP の仕様）
rest:
  - resource: https://map.yahooapis.jp/weather/V1/place
    scan_interval: 300
    timeout: 20
    headers:
      User-Agent: "Mozilla/5.0 (ha-rain-announce)"
    params:
      coordinates: "{{ state_attr('zone.home', 'longitude') }},{{ state_attr('zone.home', 'latitude') }}"
      appid: !secret yolp_appid
      output: json
      interval: 5
    sensor:
      - name: "YOLP rain intensity and forecast"
        unique_id: yolp_rain_intensity_and_forecast
        unit_of_measurement: "mm/h"
        state_class: measurement
        json_attributes_path: "$.Feature[0].Property.WeatherList"
        json_attributes:
          - Weather
        # WeatherList には観測値と 60 分先までの予報が並ぶ。状態値は最新の観測値にする
        value_template: >-
          {{ value_json.Feature[0].Property.WeatherList.Weather
             | selectattr('Type','equalto','observation')
             | map(attribute='Rainfall') | list | last | float(0) }}

input_boolean:
  # YOLP の観測値で雨の開始・停止を判定するためのフラグ
  yolp_was_raining:
    name: "YOLP Was Raining"
    icon: mdi:weather-rainy

input_datetime:
  # 前回アナウンスした予報上の降り始め時刻。実際の雨開始または予報解除でリセットする
  yolp_last_forecast_rain_start:
    name: "YOLP Last Forecast Rain Start"
    has_date: true
    has_time: true
    initial: "1970-01-01 00:00:00"
