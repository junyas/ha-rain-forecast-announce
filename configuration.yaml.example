# configuration.yaml に追記する。appid は secrets.yaml に `yolp_appid: <取得した ID>` で置く
# 座標は HA の「ホーム」ゾーンから読む（経度,緯度 の順は YOLP の仕様）
rest:
  - resource: https://map.yahooapis.jp/weather/V1/place
    scan_interval: 300
    timeout: 20
    headers:
      User-Agent: "Mozilla/5.0 (ha-rain-announce)"
    params:
      coordinates: "{{ state_attr('zone.home', 'longitude') }},{{ state_attr('zone.home', 'latitude') }}"
      appid: !secret yolp_appid
      output: json
      interval: 5
    sensor:
      - name: "YOLP rain intensity"
        unique_id: yolp_rain_intensity
        unit_of_measurement: "mm/h"
        state_class: measurement
        # WeatherList には観測値と 60 分先までの予報が並ぶ。観測値の最新だけを使う
        value_template: >-
          {{ value_json.Feature[0].Property.WeatherList.Weather
             | selectattr('Type','equalto','observation')
             | map(attribute='Rainfall') | list | last | float(0) }}

input_boolean:
  # 雨が降っている間 ON。止みを「降っていた後」に限って判定するために使う
  was_raining:
    name: "Was raining"
    icon: mdi:weather-rainy
